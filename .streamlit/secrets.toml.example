# Settings for an ONLINE deployment (Streamlit Community Cloud → your app → Settings → Secrets).
# Paste these lines there — never commit a real secrets.toml to GitHub.

# Makes the app safe to share: visitors must enter their own Gemini key,
# and uploaded CVs stay in each visitor's browser session.
PUBLIC_MODE = "true"

# Optional: your own key, usable only by someone who types APP_PASSWORD in the sidebar.
GEMINI_API_KEY = "your_gemini_api_key_here"
APP_PASSWORD = "choose-a-long-private-password"
